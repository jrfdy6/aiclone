{
  "name": "aiclone-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev",
    "build": "node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "lint": "node ./node_modules/next/dist/bin/next lint",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "next": "15.5.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "brace-expansion": "5.0.9",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.21",
    "postcss": "8.5.23",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "postcss": "$postcss",
    "next": {
      "sharp": "0.35.3"
    },
    "google-gax": {
      "rimraf": "6.1.3"
    },
    "uuid": "11.1.1"
  }
}
