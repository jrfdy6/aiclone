# Backend environment configuration
# Copy this file to .env and fill in the values.

# Firebase service account (stringified JSON)
# FIREBASE_SERVICE_ACCOUNT="{...}"

# OR provide a path to the service account file
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json

# Google Drive service account credentials
# Option A: inline JSON
# GOOGLE_DRIVE_SERVICE_ACCOUNT="{...}"
# Option B: file path (recommended)
# GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=/path/outside/repository/aiclone-drive-key.json

# Shared inbox Gmail API integration
# Production-friendly option: inject both JSON payloads directly as env vars
# GOOGLE_GMAIL_ACCOUNT_EMAIL=             # required; inject privately
# GOOGLE_GMAIL_OAUTH_CLIENT_JSON="{...}"
# GOOGLE_GMAIL_OAUTH_TOKEN_JSON="{...}"
# GOOGLE_GMAIL_SYNC_QUERY="in:inbox"
# GOOGLE_GMAIL_SYNC_MAX_RESULTS=50

# Public-output identity redaction (inject privately as a JSON object whose
# keys are private literals and whose values are safe public substitutions).
# AI_CLONE_PUBLIC_REDACTION_MAP_JSON={}

# Private runtime display name used only for owner-authored email signatures.
# The public-source default remains the neutral phrase "the owner".
# AI_CLONE_OWNER_DISPLAY_NAME=

# Approved Neo guest knowledge pack for identity-free public-source deploys.
# Inject the exact validated neo_public_knowledge_pack/v1 JSON outside Git.
# NEO_PUBLIC_KNOWLEDGE_JSON="{...}"

# Local-host option: point to files created by scripts/connect_gmail_inbox.py
# GOOGLE_GMAIL_OAUTH_CLIENT_FILE=/path/outside/repository/gmail_oauth_client.json
# GOOGLE_GMAIL_OAUTH_TOKEN_FILE=/path/outside/repository/gmail_oauth_token.json
